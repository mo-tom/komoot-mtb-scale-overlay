{
  "manifest_version": 3,
  "name": "Komoot MTB Scale Overlay",
  "version": "1.3.13",
  "description": "Shows MTB trail difficulty and continuous slope coloring for planned Komoot routes.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.komoot.com/*",
    "https://www.komoot.de/*",
    "https://api.maptiler.com/*"
  ],
  "action": {
    "default_title": "Komoot MTB Scale — Settings"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.komoot.com/*",
        "https://www.komoot.de/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.komoot.com/*",
        "https://www.komoot.de/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://www.komoot.com/*",
        "https://www.komoot.de/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
